# App
APP_NAME=AI Companion
DEV_TOKEN=dev-token

# P6 internal API / AI Worker
# MsgRail AI Worker 调用 /internal/v1/* 的 Bearer token
INTERNAL_TOKEN=dev-internal-token
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_AI_TRIGGER_TOPIC=ai_trigger
KAFKA_AI_CONSUMER_GROUP=ai_companion_worker
LOGIC_BASE_URL=http://127.0.0.1:9101
LOGIC_INTERNAL_TOKEN=dev-internal-token
AI_SELF_BASE_URL=http://127.0.0.1:8000
AI_WORKER_BATCH_CHARS=80
AI_WORKER_BATCH_MS=50

# Database
DATABASE_URL=postgresql+asyncpg://postgres:ai_companion@127.0.0.1:5432/ai_companion
DB_ECHO=false
DEV_USER_EXTERNAL_ID=dev-user

# P2 context / summary
CONTEXT_WINDOW_TOKENS=32768
SUMMARY_ENABLED=true
SUMMARY_TRIGGER_RATIO=0.7
SUMMARY_KEEP_RECENT_MESSAGES=6
SUMMARY_MAX_TOKENS=512
SUMMARY_MODEL=
# 空 = LLM_MODEL；请确认所选模型在百炼有免费额度或已开通
SUMMARY_TEMPERATURE=0.2
SUMMARY_SYNC=false
TOKEN_SAFETY_MARGIN=1.15

# P3 tools / MCP
TOOLS_ENABLED=true
MAX_TOOL_STEPS=5
TOOL_TIMEOUT_SECONDS=10
TOOL_PARALLEL_LIMIT=4
MAX_TOOL_RESULT_TOKENS=2000
TOOL_PERMISSION_MODE=readonly_auto
MCP_CONFIG_PATH=config/mcp_servers.json

# P4.1 long-term memory
MEMORY_ENABLED=true
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
MEMORY_TOP_K=5
MEMORY_MIN_SIMILARITY=0.35
MEMORY_MAX_TOKENS=600
MEMORY_EXTRACT_EVERY_TURNS=3
MEMORY_EXTRACTION_MODEL=
# 空 = LLM_MODEL；请确认所选模型在百炼有免费额度或已开通
MEMORY_SYNC=false

# P6 MCP tool profiles
# private 为空 = 暴露所有只读工具；shared 为空 = 不暴露任何工具
PRIVATE_TOOL_ALLOWLIST=
SHARED_TOOL_ALLOWLIST=time__get_current_time,fun__calculator,fun__random_picker,fun__roll_dice,fun__holiday,fun__trivia,knowledge__wikipedia

# P6 web search (key intentionally empty until configured)
# bocha | doubao
SEARCH_PROVIDER=bocha
BOCHA_API_KEY=
DOUBAO_SEARCH_API_KEY=
# Custom 版默认端点；Global 版改成 https://open.feedcoopapi.com/search_api/global_search
DOUBAO_SEARCH_ENDPOINT=https://open.feedcoopapi.com/search_api/web_search
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5

# P6 web fetch
WEB_FETCH_TIMEOUT_SECONDS=8
WEB_FETCH_MAX_BYTES=1000000
WEB_FETCH_MAX_CHARS=5000

# P6 knowledge
# 大陆网络通常无法直连 Wikipedia；需要代理时再设为 true
WIKIPEDIA_ENABLED=false
WIKIPEDIA_LANG=zh
RSS_FEEDS_PATH=config/rss_feeds.json
RSS_MAX_ITEMS=5
TOOL_CACHE_TTL_SECONDS=300

# P4.2 document RAG
RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
RAG_MAX_TOKENS=1200
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=50
RAG_MAX_FILE_BYTES=2000000
RAG_MAX_CHUNKS=100
RAG_EMBEDDING_BATCH_SIZE=10

# LLM provider: fake | openai_compat
LLM_PROVIDER=fake

# OpenAI-compatible provider (DeepSeek example)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_INCLUDE_USAGE=true

# Qwen / DashScope OpenAI-compatible mode:
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# P0 fake provider
FAKE_RESPONSE=你好呀，我是小火。今天想聊点什么？
FAKE_DELAY_SECONDS=0.02

# SSE
SSE_HEARTBEAT_SECONDS=15
