# App
APP_NAME=AI Companion
DEV_TOKEN=dev-token

# Database
DATABASE_URL=postgresql+asyncpg://postgres:ai_companion@127.0.0.1:5432/ai_companion
DB_ECHO=false
DEV_USER_EXTERNAL_ID=dev-user

# P2 context / summary
CONTEXT_WINDOW_TOKENS=32768
SUMMARY_ENABLED=true
SUMMARY_TRIGGER_RATIO=0.7
SUMMARY_KEEP_RECENT_MESSAGES=6
SUMMARY_MAX_TOKENS=512
SUMMARY_MODEL=
# 空 = LLM_MODEL；请确认所选模型在百炼有免费额度或已开通
SUMMARY_TEMPERATURE=0.2
SUMMARY_SYNC=false
TOKEN_SAFETY_MARGIN=1.15

# P3 tools / MCP
TOOLS_ENABLED=true
MAX_TOOL_STEPS=5
TOOL_TIMEOUT_SECONDS=10
TOOL_PARALLEL_LIMIT=4
MAX_TOOL_RESULT_TOKENS=2000
TOOL_PERMISSION_MODE=readonly_auto
MCP_CONFIG_PATH=config/mcp_servers.json

# P4.1 long-term memory
MEMORY_ENABLED=true
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
MEMORY_TOP_K=5
MEMORY_MIN_SIMILARITY=0.35
MEMORY_MAX_TOKENS=600
MEMORY_EXTRACT_EVERY_TURNS=3
MEMORY_EXTRACTION_MODEL=
# 空 = LLM_MODEL；请确认所选模型在百炼有免费额度或已开通
MEMORY_SYNC=false

# P4.2 document RAG
RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
RAG_MAX_TOKENS=1200
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=50
RAG_MAX_FILE_BYTES=2000000
RAG_MAX_CHUNKS=100
RAG_EMBEDDING_BATCH_SIZE=10

# Qwen / DashScope OpenAI-compatible mode
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_INCLUDE_USAGE=true

# SSE
SSE_HEARTBEAT_SECONDS=15
